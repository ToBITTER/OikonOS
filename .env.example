NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://oikonos:oikonos_local_only@localhost:5432/oikonos
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
EMAIL_FROM=OikonOS <notifications@your-domain.com>
EMAIL_REPLY_TO=support@your-domain.com
APP_URL=http://localhost:5173
